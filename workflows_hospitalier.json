ersion":1.3,"position":[232,240],"id":"705301a0-1354-4145-af1a-864ec5e14646","name":"OpenAI Chat Model","credentials":{"openAiApi":{"id":"6ErSqHHjuNTwT6ik","name":"OpenAi account"}}},{"parameters":{"endpointUrl":"http://localhost:8000/mcp","options":{}},"type":"@n8n/n8n-nodes-langchain.mcpClientTool","typeVersion":1.2,"position":[360,240],"id":"9e12f209-bb18-48ca-850f-036fe8badde6","name":"MCP Client"},{"parameters":{"promptType":"define","text":"=Question: {{ $json.body.query }}\n\nRègles :\n1. Appelle get_schema() en premier pour comprendre les tables.\n2. Génère une requête SQL précise avec les jointures nécessaires.\n3. Appelle run_sql() et retourne UNIQUEMENT les données brutes (JSON).\n","options":{}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[224,16],"id":"f6b68f6a-01c0-4756-8905-4d5b840fbfee","name":"SQL Agent"},{"parameters":{"model":{"__rl":true,"value":"gpt-4o-mini","mode":"list","cachedResultName":"gpt-4o-mini"},"builtInTools":{},"options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.3,"position":[648,240],"id":"66c63843-2fdf-44f2-878e-4f49ce2ac018","name":"OpenAI Chat Model1","credentials":{"openAiApi":{"id":"6ErSqHHjuNTwT6ik","name":"OpenAi account"}}},{"parameters":{"promptType":"define","text":"=Voici la question de l'utilisateur : {{ $('Webhook').item.json.body.query }}\n\nEt voici les données brutes extraites de la base de données :\n{{ $json.output }}\n\nTA MISSION : Transforme ces données en un rapport d'analyse structuré.\nTU DOIS RÉPONDRE UNIQUEMENT EN JSON avec cette structure précise :\n{\n  \"summary\": \"Résumé de l'analyse\",\n  \"metrics\": {\n    \"total_patients\": 0,\n    \"age_moyen\": 0,\n    \"service_plus_charge\": \"Nom\",\n    \"cout_total\": 0\n  },\n  \"insights\": [\"Point clé 1\", \"Point clé 2\"],\n  \"anomalies\": [\"Alerte potentielle 1\"],\n  \"charts\": {\n    \"patients_par_service\": [{\"service\": \"...\", \"value\": 0}],\n    \"diagnostics_frequents\": [{\"diagnostic\": \"...\", \"total\": 0}]\n  },\n  \"conclusion\": \"Bref avis médical\"\n}\n","options":{}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[576,16],"id":"d93d905b-41d1-4476-b0fa-72d7d5ebb20d","name":"AI Agent Analyste"},{"parameters":{"promptType":"define","text":"=Analyse JSON : {{ $json.output }}\n\nTa mission :\n1. Identifie les situations à risque.\n2. Appelle creer_alerte() pour chaque situation critique.\n3. Appelle calculer_score_risque() si des patients hospitalisés sont mentionnés.\n4. Appelle envoyer_rapport() si tu génères une alerte critique.\n","options":{}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[928,16],"id":"ffac5bd3-9033-4375-a30a-6740b60f75a6","name":"AI Agent Alerte"},{"parameters":{"model":{"__rl":true,"value":"gpt-4o-mini","mode":"list","cachedResultName":"gpt-4o-mini"},"builtInTools":{},"options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.3,"position":[936,240],"id":"742a6647-6f18-45e6-ac0a-8eb4bdd0fb1c","name":"OpenAI Chat Model2","credentials":{"openAiApi":{"id":"6ErSqHHjuNTwT6ik","name":"OpenAi account"}}},{"parameters":{"endpointUrl":"http://localhost:8001/mcp","options":{}},"type":"@n8n/n8n-nodes-langchain.mcpClientTool","typeVersion":1.2,"position":[1064,240],"id":"6d8170e4-87e8-4703-aa2e-95c920883fef","name":"MCP Client 2"},{"parameters":{"model":{"__rl":true,"value":"gpt-4o-mini","mode":"list","cachedResultName":"gpt-4o-mini"},"builtInTools":{},"options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.3,"position":[1352,240],"id":"a47004c7-fa04-47fd-bc29-cc7778666412","name":"OpenAI Chat Model3","credentials":{"openAiApi":{"id":"6ErSqHHjuNTwT6ik","name":"OpenAi account"}}},{"parameters":{"respondWith":"json","responseBody":"={{ JSON.parse($json.output) }}","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[1632,-80],"id":"4aecdae6-c98d-4829-8e5b-1b39d155557d","name":"Respond to Webhook1"},{"parameters":{"promptType":"define","text":"=Analyse : {{ $('AI Agent Analyste').item.json.output }}\nAlertes : {{ $json.output }}\n\nTA MISSION :\nFusionne ces deux objets en un seul JSON final structuré pour un Dashboard.\nAssure-toi que toutes les clés de l'Analyse sont présentes (summary, metrics, insights, anomalies, charts, conclusion).\n\nCONSIGNE CRUCIALE POUR LE DASHBOARD :\nLe champ \"alertes\" doit impérativement être un TABLEAU (Array []) d'objets simplifiés.\nChaque objet dans ce tableau DOIT avoir ce format :\n{\n  \"niveau\": \"critique\" ou \"warning\" ou \"info\",\n  \"service\": \"Nom du service\",\n  \"message\": \"Description courte de l'alerte\"\n}\n\n\"RÉPONDS UNIQUEMENT AVEC LE JSON PUR. Aucun texte avant, aucun texte après, aucune balise markdown comme ```json.\"","options":{}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[1280,16],"id":"5e6ac7a8-18d9-4a84-a00f-bcfd265589eb","name":"AI Agent Format"},{"parameters":{"method":"POST","url":"https://webhook.site/d2754b91-b29a-4e32-9093-d7b8c143062c","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify($json.output) }}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[1632,112],"id":"99896657-7fc9-4341-a6a4-c36bfe4b5ea7","name":"HTTP Request"}],"connections":{"Webhook":{"main":[[{"node":"SQL Agent","type":"main","index":0}]]},"OpenAI Chat Model":{"ai_languageModel":[[{"node":"SQL Agent","type":"ai_languageModel","index":0}]]},"MCP Client":{"ai_tool":[[{"node":"SQL Agent","type":"ai_tool","index":0}]]},"SQL Agent":{"main":[[{"node":"AI Agent Analyste","type":"main","index":0}]]},"OpenAI Chat Model1":{"ai_languageModel":[[{"node":"AI Agent Analyste","type":"ai_languageModel","index":0}]]},"AI Agent Analyste":{"main":[[{"node":"AI Agent Alerte","type":"main","index":0}]]},"OpenAI Chat Model2":{"ai_languageModel":[[{"node":"AI Agent Alerte","type":"ai_languageModel","index":0}]]},"MCP Client 2":{"ai_tool":[[{"node":"AI Agent Alerte","type":"ai_tool","